---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('about', 'about');
const { Content } = await render(entry);
---

<Layout
  title="About — Tay"
  description="The longer version. How I went from modding game servers to building production backend systems and doing security research."
>

  <div class="page-header">
    <h1 class="page-title">About</h1>
    <p class="page-desc">The longer version.</p>
  </div>

  <div class="about-content">
    <div class="prose narrative">
      <Content />
    </div>

    <p class="cv-nudge">
      <a href="/cv">The structured version lives here.</a>
    </p>
  </div>

</Layout>

<style>
  .about-content {
    max-width: 600px;
  }

  .narrative p {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.85;
    margin-bottom: 1.1rem;
  }

  .narrative p:last-child {
    margin-bottom: 0;
  }

  .cv-nudge {
    margin-top: 2.5rem;
    font-size: 0.82rem;
  }

  .cv-nudge a {
    color: var(--text-3);
    transition: color 0.15s;
  }

  .cv-nudge a:hover {
    color: var(--text-2);
  }
</style>
