---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
---

<Layout title="404 | Oscar Fernandez" description="Page not found.">
  <div class="not-found">
    <p class="code">404</p>
    <h1 class="message">Page not found</h1>
    <p class="sub">Whatever you were looking for isn't here.</p>
    <a href="/" class="home-link"><Arrow dir="left" /> Back home</a>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 4rem 0;
  }

  .code {
    font-size: 0.8667rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .message {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .sub {
    font-size: 0.9rem;
    color: var(--text-2);
    margin-bottom: 2rem;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9333rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .home-link:hover {
    color: var(--accent);
  }
</style>
