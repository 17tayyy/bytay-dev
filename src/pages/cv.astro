---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import cvData from "../data/cv.json";

const {
  name,
  title,
  contact,
  experience,
  projects,
  education,
  training,
  skills,
  languages,
} = cvData;

function shortPeriod(period: string): string {
  return period
    .replace(
      /\b(January|February|March|April|June|July|August|September|October|November|December)\b/g,
      (month) => month.slice(0, 3),
    )
    .replace(/\bpresent\b/, "Present");
}

---

<Layout
  title="Resume | Oscar Fernandez"
  description="Resume of Oscar Fernandez, Co-Founder and CTO at Intake. Backend, AI and infrastructure, with skills in Python, FastAPI, Claude, MCP, AWS, Terraform, Rust, and more."
>
  <div class="cv">
    <header class="cv-header">
      <div class="cv-identity">
        <h1 class="cv-name">{name}</h1>
        <p class="cv-title">{title}</p>
        <p class="cv-contact">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={contact.github} target="_blank" rel="noopener noreferrer"
            >{contact.github.replace("https://", "")}</a
          >
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer"
            >LinkedIn</a
          >
        </p>
      </div>
      <a href="/CV_Oscar_Fernandez.pdf" download class="cv-download">
        Download PDF
      </a>
    </header>

    <section class="cv-section">
      <h2 class="cv-section-title">Experience</h2>
      {
        experience.map((entry) => (
          <div class="cv-entry">
            <div>
              <div class="cv-entry-head">
                <h3 class="cv-entry-title">{entry.role}</h3>
                <span class="meta">{shortPeriod(entry.period)}</span>
              </div>
              <p class="cv-entry-sub">
                {entry.company}
                {entry.location && ` · ${entry.location}`}
              </p>
            </div>
            {entry.description && <p class="cv-text">{entry.description}</p>}
            <ul class="cv-bullets">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            {entry.tags.length > 0 && (
              <p class="meta cv-stack">{entry.tags.join(", ")}</p>
            )}
          </div>
        ))
      }
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Projects</h2>
      {
        projects.map((project) => (
          <div class="cv-entry">
            <div class="cv-entry-head">
              <h3 class="cv-entry-title">{project.name}</h3>
              {project.link && (
                <a
                  href={project.link.url}
                  class="cv-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.link.label === "github"
                    ? "GitHub"
                    : project.link.label}{" "}
                  <Arrow dir="up-right" />
                </a>
              )}
            </div>
            <p class="cv-text">{project.description}</p>
            <p class="meta cv-stack">{project.stack.split(" / ").join(", ")}</p>
          </div>
        ))
      }
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Technical skills</h2>
      <div class="cv-lines">
        {
          skills.map((skill) => (
            <p>
              <span class="cv-label">{skill.label}</span> {skill.value}
            </p>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Education</h2>
      {
        education.map((entry) => (
          <div class="cv-entry">
            <div>
              <div class="cv-entry-head">
                <h3 class="cv-entry-title">{entry.degree}</h3>
                <span class="meta">{shortPeriod(entry.period)}</span>
              </div>
              {entry.institution && (
                <p class="cv-entry-sub">{entry.institution}</p>
              )}
            </div>
            {entry.note && <p class="cv-text">{entry.note}</p>}
          </div>
        ))
      }
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Languages</h2>
      <div class="cv-lines">
        {
          languages.map((lang) => (
            <p>
              <span class="cv-label">{lang.label}</span> {lang.value}
            </p>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Additional training</h2>
      {
        training.map((entry) => (
          <div class="cv-entry">
            <div>
              <div class="cv-entry-head">
                <h3 class="cv-entry-title">{entry.title}</h3>
                {entry.period && <span class="meta">{entry.period}</span>}
              </div>
              {entry.subtitle && <p class="cv-entry-sub">{entry.subtitle}</p>}
            </div>
            {entry.note && <p class="cv-text">{entry.note}</p>}
          </div>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
    padding-top: 0.5rem;
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
  }

  .cv-identity {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cv-name {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .cv-title {
    font-size: 1.0667rem;
    color: var(--text-2);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: 0.3rem;
    font-size: 0.8667rem;
  }

  .cv-contact a,
  .cv-link {
    color: var(--text-2);
    transition: color 0.15s;
  }

  .cv-contact a:hover,
  .cv-link:hover {
    color: var(--accent);
  }

  .cv-download {
    font-size: 0.9333rem;
    color: var(--text);
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--border-2);
    border-radius: 6px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .cv-download:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cv-section-title {
    font-size: 1.3333rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: -0.25rem;
  }

  .cv-entry {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.15rem 1rem;
    flex-wrap: wrap;
  }

  .cv-entry-title {
    font-size: 1.0667rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .cv-entry-sub {
    margin-top: 0.15rem;
    font-size: 0.9667rem;
    color: var(--text-2);
  }

  .cv-text,
  .cv-bullets {
    font-size: 0.9667rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .cv-bullets {
    list-style: disc;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cv-bullets li::marker {
    color: var(--text-3);
  }

  .cv-stack {
    line-height: 1.6;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-size: 0.9333rem;
  }

  .cv-lines {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.9667rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .cv-label {
    font-weight: 500;
    color: var(--text);
    margin-right: 0.35rem;
  }

  @media print {
    :root {
      --bg: #ffffff;
      --surface: #f9f9f9;
      --surface-2: #f3f3f3;
      --border: #e0e0e0;
      --border-2: #c8c8c8;
      --text: #111111;
      --text-2: #444444;
      --text-3: #666666;
      --accent: #c2410c;
    }

    body {
      background: #fff;
    }

    .cv-download {
      display: none;
    }

    .site-main {
      padding: 0;
    }

    .container {
      padding: 0;
      max-width: 100%;
    }

    .cv {
      gap: 2rem;
    }

    .cv-entry {
      break-inside: avoid;
    }

    a {
      color: inherit;
    }

    @page {
      margin: 1.5cm 2cm;
    }
  }
</style>
