---
import Layout from "../layouts/Layout.astro";
import ProjectItem from "../components/ProjectItem.astro";
import projects from "../data/projects.json";
---

<Layout
  title="Projects | Oscar Fernandez"
  description="Things I've built: Intake, a customer support platform, ArdiQ, a Rust-core task queue for Python, wong, an external brain for coding agents, and Zona 14, a football analytics app."
>
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="page-desc">Things I've built or am building.</p>
  </div>

  <div class="project-list">
    {projects.map((project) => <ProjectItem project={project} />)}
  </div>
</Layout>

<style>
  .page-desc {
    margin-bottom: 2.25rem;
  }
</style>
