---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Layout
  title="Blog"
  description="Technical notes and the occasional opinion."
>

  <div class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="page-desc">Technical notes. Irregularly updated.</p>
  </div>

  {posts.length === 0 ? (
    <div class="empty-state">
      <p class="empty-text">
        No posts yet. I have drafts. They're just in indefinite review.
      </p>
    </div>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="post-item">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()} class="post-date">
              {formatDate(post.data.date)}
            </time>
            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <div class="post-content">
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  )}

</Layout>

<style>
  /* Empty state */
  .empty-state {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
  }

  .empty-text {
    font-size: 0.88rem;
    color: var(--text-2);
    font-style: italic;
  }

  /* Post list */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    display: block;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.15s;
  }

  .post-item:first-child {
    border-top: 1px solid var(--border);
  }

  .post-item:hover .post-title {
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-2);
    flex-shrink: 0;
  }

  .post-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .post-title {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
    transition: color 0.15s;
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.65;
  }
</style>
