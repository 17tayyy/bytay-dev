---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostItem from "../../components/PostItem.astro";
import { getAllTags } from "../../utils/tags";
import { breadcrumbSchema } from "../../utils/schema";

const allPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const tags = getAllTags(posts);

const schema = breadcrumbSchema([
  { name: "Home", url: "https://bytay.dev/" },
  { name: "Blog", url: "https://bytay.dev/blog/" },
]);
---

<Layout
  title="Blog | Oscar Fernandez"
  description="Technical notes on backend systems, security research, Rust, and whatever I'm building at the time."
  {schema}
>
  <div class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="page-desc">Technical notes. Irregularly updated.</p>
  </div>

  {
    tags.length > 0 && (
      <div class="tag-filter">
        {tags.map(({ slug, tag }) => (
          <a href={`/blog/tags/${slug}`} class="tag">
            {tag}
          </a>
        ))}
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <div class="empty-state">
        <p class="empty-text">
          No posts yet. I have drafts. They're just in indefinite review.
        </p>
      </div>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>
    )
  }
</Layout>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }

  .empty-state {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
  }

  .empty-text {
    font-size: 0.88rem;
    color: var(--text-2);
    font-style: italic;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
