---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostIndex from "../../../components/PostIndex.astro";
import TopicTabs from "../../../components/TopicTabs.astro";
import { getAllTags, getPostsByTagSlug, tagSlug } from "../../../utils/tags";
import { breadcrumbSchema } from "../../../utils/schema";

export async function getStaticPaths() {
  const posts = (
    await getCollection("blog", ({ data }) =>
      import.meta.env.PROD ? !data.draft : true,
    )
  ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const tags = getAllTags(posts);
  return tags.map(({ slug, tag }) => ({
    params: { tag: slug },
    props: {
      tagName: tag,
      tags,
      total: posts.length,
      posts: getPostsByTagSlug(posts, slug),
    },
  }));
}

const { tagName, tags, total, posts } = Astro.props;
const slug = tagSlug(tagName);

const schema = breadcrumbSchema([
  { name: "Home", url: "https://bytay.dev/" },
  { name: "Blog", url: "https://bytay.dev/blog/" },
  { name: tagName, url: `https://bytay.dev/blog/tags/${slug}/` },
]);
---

<Layout
  title={`${tagName} posts | Oscar Fernandez`}
  description={`Posts about ${tagName}.`}
  {schema}
>
  <div class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="page-desc">Technical notes. Irregularly updated.</p>
  </div>

  <TopicTabs topics={tags} {total} active={slug} />
  <PostIndex {posts} />
</Layout>

<style>
  .page-desc {
    margin-bottom: 2rem;
  }
</style>
