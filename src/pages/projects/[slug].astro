---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import projectsData from "../../data/projects.json";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const meta = projectsData.find((p) => "slug" in p && p.slug === entry.id);
---

<Layout
  title={`${entry.data.title} | Tay`}
  description={meta?.description ?? ""}
  type="article"
>
  <div class="project-header">
    <a href="/projects" class="back-link">← projects</a>
    <div class="title-row">
      <h1 class="project-title">{entry.data.title}</h1>
      {
        meta && (
          <div class="badges">
            {meta.visibility === "private" && (
              <span class="badge badge-private">private</span>
            )}
            {meta.status === "active" && (
              <span class="badge badge-active">active</span>
            )}
            {meta.type === "disclosure" && (
              <span class="badge badge-disclosure">disclosure</span>
            )}
          </div>
        )
      }
    </div>
    {meta && <p class="project-desc">{meta.description}</p>}
    {
      meta && meta.tags.length > 0 && (
        <div class="tags">
          {meta.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
    {
      meta && meta.links.length > 0 && (
        <div class="project-links">
          {meta.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>

  <hr class="divider" />

  <article class="prose">
    <Content />
  </article>
</Layout>

<style>
  .project-header {
    max-width: 660px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    margin-bottom: 1.75rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .project-title {
      font-size: 1.75rem;
    }
  }

  .badges {
    display: flex;
    gap: 0.35rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    border: 1px solid;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .badge-private {
    color: var(--text-2);
    border-color: var(--border-2);
    background: var(--surface);
  }

  .badge-active {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.2);
    background: rgba(74, 222, 128, 0.05);
  }

  .badge-disclosure {
    color: var(--accent);
    border-color: rgba(249, 115, 22, 0.2);
    background: var(--accent-dim);
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .project-link:hover {
    color: var(--accent);
  }

  .prose {
    max-width: 660px;
  }
</style>
