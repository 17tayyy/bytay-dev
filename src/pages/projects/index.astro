---
import Layout from "../../layouts/Layout.astro";
import projects from "../../data/projects.json";
---

<Layout
  title="Projects | Tay"
  description="Things I've built, backend tools, security research, C2 frameworks, and a few things with interesting readmes."
>
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="page-desc">Things I've built. Some are public. Some aren't.</p>
  </div>

  <div class="projects-list">
    {
      projects.map((project) => {
        const hasPage = "slug" in project && project.slug;
        const Wrapper = hasPage ? "a" : "article";
        return (
          <Wrapper
            class:list={["project-item", { clickable: hasPage }]}
            {...(hasPage ? { href: `/projects/${project.slug}` } : {})}
          >
            <div class="project-header">
              <div class="project-title-row">
                <h2 class="project-name">{project.name}</h2>
                <div class="project-badges">
                  {project.visibility === "private" && (
                    <span class="badge badge-private">private</span>
                  )}
                  {project.status === "active" && (
                    <span class="badge badge-active">active</span>
                  )}
                  {project.type === "disclosure" && (
                    <span class="badge badge-disclosure">disclosure</span>
                  )}
                </div>
              </div>
              {!hasPage && project.links.length > 0 && (
                <div class="project-links">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-link"
                    >
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              )}
              {hasPage && <span class="project-arrow">→</span>}
            </div>
            <p class="project-desc">{project.description}</p>
            {project.tags.length > 0 && (
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </Wrapper>
        );
      })
    }
  </div>
</Layout>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-item {
    display: block;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .project-item:first-child {
    border-top: 1px solid var(--border);
  }

  .project-item.clickable {
    cursor: pointer;
    transition: background 0.15s;
    margin: 0 -1rem;
    padding: 1.75rem 1rem;
  }

  .project-item.clickable:hover {
    background: var(--surface);
  }

  .project-item.clickable:hover .project-name {
    color: var(--accent);
  }

  .project-item.clickable:hover .project-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .project-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .project-name {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .project-badges {
    display: flex;
    gap: 0.35rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    border: 1px solid;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .badge-private {
    color: var(--text-2);
    border-color: var(--border-2);
    background: var(--surface);
  }

  .badge-active {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.2);
    background: rgba(74, 222, 128, 0.05);
  }

  .badge-disclosure {
    color: var(--accent);
    border-color: rgba(249, 115, 22, 0.2);
    background: var(--accent-dim);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .project-link:hover {
    color: var(--accent);
  }

  .project-arrow {
    font-size: 0.85rem;
    color: var(--text-2);
    flex-shrink: 0;
    transition:
      color 0.15s,
      transform 0.15s;
    display: inline-block;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }
</style>
