---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostItem from "../components/PostItem.astro";

const allPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout
  title="Tay | Backend Developer & Security Researcher"
  description="Backend developer and security researcher. Writing about backend systems, security research, and whatever I'm building. Based in Mataró, Barcelona."
>
  <div class="home">
    <section class="hero">
      <p class="hero-label label">Oscar Fernandez</p>
      <h1 class="hero-name">Tay</h1>
      <p class="hero-meta">
        Backend developer &amp; security researcher
        <span class="sep">·</span>
        18
        <span class="sep">·</span>
        Mataró, Barcelona
      </p>

      <p class="tagline">
        Writes code that ships.<br />
        Finds code that shouldn't.
      </p>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="writing-section">
          <div class="post-list">
            {recentPosts.map((post) => (
              <PostItem post={post} />
            ))}
          </div>
          <a href="/blog" class="more-link">
            all posts →
          </a>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .home {
    padding-top: 1.5rem;
    max-width: 580px;
  }

  .hero-label {
    margin-bottom: 0.4rem;
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  @media (min-width: 640px) {
    .hero-name {
      font-size: 4.5rem;
    }
  }

  .hero-meta {
    font-size: 0.82rem;
    color: var(--text-2);
  }

  .sep {
    margin: 0 0.35rem;
    color: var(--text-3);
  }

  .tagline {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin-top: 1.5rem;
    color: var(--text);
  }

  @media (min-width: 640px) {
    .tagline {
      font-size: 1.2rem;
    }
  }

  .writing-section {
    margin-top: 3rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .more-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-2);
    margin-top: 0.75rem;
    transition: color 0.15s;
  }

  .more-link:hover {
    color: var(--accent);
  }
</style>
