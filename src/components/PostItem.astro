---
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../utils/reading";

interface Props {
  post: CollectionEntry<"blog">;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;

const date = post.data.date;
const label = date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  ...(compact ? {} : { year: "numeric" }),
});
---

{
  compact ? (
    <a href={`/blog/${post.id}/`} class="post-row">
      <span class="post-row-title">{post.data.title}</span>
      <time datetime={date.toISOString()} class="meta post-row-date">
        {label}
      </time>
    </a>
  ) : (
    <a href={`/blog/${post.id}/`} class="post-item">
      <span class="post-title">{post.data.title}</span>
      <span class="post-desc">{post.data.description}</span>
      <span class="meta">
        <time datetime={date.toISOString()}>{label}</time> ·{" "}
        {readingTime(post.body)}
      </span>
    </a>
  )
}

<style>
  .post-item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 0;
  }

  .post-item + .post-item {
    border-top: 1px solid var(--border);
  }

  .post-item:first-child {
    padding-top: 0;
  }

  .post-title {
    font-size: 1.1333rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color 0.15s;
  }

  .post-desc {
    font-size: 0.9333rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .post-item:hover .post-title,
  .post-row:hover .post-row-title {
    color: var(--accent);
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-row-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    transition: color 0.15s;
  }

  .post-row-date {
    flex-shrink: 0;
  }
</style>
