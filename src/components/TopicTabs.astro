---
interface Props {
  topics: { tag: string; slug: string; count: number }[];
  total: number;
  active?: string;
}

const { topics, total, active } = Astro.props;

const tabs = [
  { label: "All", href: "/blog/", count: total, isActive: !active },
  ...topics.map(({ tag, slug, count }) => ({
    label: tag,
    href: `/blog/tags/${slug}/`,
    count,
    isActive: active === slug,
  })),
];
---

<nav class="topic-tabs" aria-label="Topics">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class="topic-tab"
        data-active={tab.isActive ? "true" : "false"}
        aria-current={tab.isActive ? "page" : undefined}
      >
        {tab.label} <span class="meta topic-count">{tab.count}</span>
      </a>
    ))
  }
</nav>

<style>
  .topic-tabs {
    display: flex;
    column-gap: 1.45rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topic-tabs::-webkit-scrollbar {
    display: none;
  }

  /* On narrow screens the tabs scroll; the fade hints there are more */
  @media (max-width: 639px) {
    .topic-tabs {
      padding-right: 2rem;
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    }
  }

  .topic-tab {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 0.4rem 0 0.65rem;
    font-size: 0.9333rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .topic-tab:hover {
    color: var(--accent);
  }

  .topic-tab[data-active="true"] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .topic-count {
    font-size: 0.8rem;
  }
</style>
