---
import Arrow from "./Arrow.astro";

interface ProjectLink {
  label: string;
  url: string;
}

interface Props {
  project: {
    name: string;
    role: string;
    description: string;
    tags: string[];
    links: ProjectLink[];
  };
}

const { project } = Astro.props;

function linkText(link: ProjectLink): string {
  if (link.label !== "Website") return link.label;
  return new URL(link.url).hostname.replace(/^www\./, "");
}
---

<article class="project">
  <div class="project-head">
    <div class="project-id">
      <h2 class="project-name">{project.name}</h2>
      <span class="meta">{project.role}</span>
    </div>
    <div class="project-links">
      {
        project.links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {linkText(link)} <Arrow dir="up-right" />
          </a>
        ))
      }
    </div>
  </div>
  <p class="project-desc">{project.description}</p>
  {
    project.tags.length > 0 && (
      <p class="meta project-stack">{project.tags.join(" · ")}</p>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.85rem 0;
    border-top: 1px solid var(--border);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }

  .project-id {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .project-name {
    font-size: 1.3333rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .project-links {
    display: flex;
    gap: 1.2rem;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9333rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .project-links a:hover {
    color: var(--accent);
  }

  .project-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  .project-stack {
    margin-top: 0.15rem;
  }
</style>
