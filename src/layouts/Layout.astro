---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  wide?: boolean;
  schema?: object | object[];
}

const {
  title = "Oscar Fernandez",
  description = "Backend developer and security researcher based in Mataró, Barcelona.",
  image,
  type = "website",
  wide = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://bytay.dev").href;

const DEFAULT_OG = "https://bytay.dev/og.png";
const ogImage = image
  ? image.startsWith("http")
    ? image
    : new URL(image, "https://bytay.dev").href
  : DEFAULT_OG;

const nav = [
  { label: "About", href: "/about" },
  { label: "CV", href: "/cv" },
  { label: "Blog", href: "/blog" },
];

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        function getTheme() {
          const stored = localStorage.getItem("theme");
          const prefersLight = window.matchMedia(
            "(prefers-color-scheme: light)",
          ).matches;
          return stored ?? (prefersLight ? "light" : "dark");
        }
        document.documentElement.dataset.theme = getTheme();
        document.addEventListener("astro:before-swap", (e) => {
          e.newDocument.documentElement.dataset.theme = getTheme();
        });
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Oscar Fernandez - Blog"
      href={new URL("rss.xml", "https://bytay.dev").href}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO
      {title}
      {description}
      image={ogImage}
      {type}
      canonicalURL={canonicalURL}
      {schema}
    />

    <ClientRouter />
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-inner">
          <a href="/" class="site-logo">tay</a>
          <nav class="site-nav" aria-label="Main navigation">
            {
              nav.map((item) => {
                const isActive =
                  item.href === "/"
                    ? pathname === "/"
                    : pathname === item.href ||
                      pathname.startsWith(item.href + "/");
                return (
                  <a
                    href={item.href}
                    class="nav-link"
                    data-active={isActive ? "true" : "false"}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                );
              })
            }
            <button
              class="theme-toggle"
              type="button"
              aria-label="Toggle theme"
              title="Toggle theme"
            >
              <svg
                class="theme-icon-sun"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                ></path>
              </svg>
              <svg
                class="theme-icon-moon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </nav>
        </div>
      </div>
    </header>

    <main class="site-main">
      <div class:list={["container", { wide }]}>
        <slot />
      </div>
    </main>

    <script>
      function setupThemeToggle() {
        const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
        if (!btn || btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";

        btn.addEventListener("click", async (event) => {
          const current = document.documentElement.dataset.theme ?? "dark";
          const next = current === "dark" ? "light" : "dark";

          const apply = () => {
            document.documentElement.dataset.theme = next;
            localStorage.setItem("theme", next);
          };

          const supportsViewTransitions =
            typeof (document as any).startViewTransition === "function";
          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;

          if (!supportsViewTransitions || reducedMotion) {
            apply();
            return;
          }

          const x = event.clientX;
          const y = event.clientY;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          );

          document.documentElement.classList.add("theme-transitioning");
          const transition = (document as any).startViewTransition(apply);
          transition.finished.finally(() => {
            document.documentElement.classList.remove("theme-transitioning");
          });

          try {
            await transition.ready;
            const clipPath = [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`,
            ];
            const reverse = next === "dark";
            document.documentElement.animate(
              {
                clipPath: reverse ? [...clipPath].reverse() : clipPath,
              },
              {
                duration: 500,
                easing: "cubic-bezier(0.4, 0, 0.2, 1)",
                fill: "forwards",
                pseudoElement: reverse
                  ? "::view-transition-old(root)"
                  : "::view-transition-new(root)",
              },
            );
          } catch {}
        });
      }

      setupThemeToggle();
      document.addEventListener("astro:after-swap", setupThemeToggle);
    </script>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <span class="footer-copy">© 2026 Oscar Fernandez</span>
          <nav class="footer-links" aria-label="Social links">
            <a
              href="https://github.com/17tayyy"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
            <a
              href="https://www.linkedin.com/in/oscar-fernandez-45891229b/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
            <a href="mailto:oscarfdst@proton.me">Email</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
