{
	"compatibility_date": "2026-05-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "bytay-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Per-request cap so a bug cannot burn unbounded CPU on the paid plan.
	"limits": { "cpu_ms": 50, "subrequests": 50 }
}